{
    "name": "vankosoft/websocket-bundle",
    "description": "Swoole Websocket for Symfony",
    "type": "symfony-bundle",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Vankosoft\\WebsocketBundle\\": "src/"
        }
    },
    "authors": [
        {
            "name": "Ivan I. Atanasov",
            "email": "i.atanasov77@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        
        "symfony/framework-bundle": "^7.4|^8.1",
        "symfony/console": "^7.4|^8.1",
        "symfony/config": "^7.4|^8.1",
        "symfony/dependency-injection": "^7.4|^8.1",
        
        "swoole-bundle/swoole-bundle": "^0.35"
    },
    "suggest": {
        "cboden/ratchet": "Required this for use RatchetConnection.",
        "react/react": "Required this for use Async Operations.",
        "react/partial": "Required this for use Async Operations.",
        "amphp/amp": "Required this for use DeferredCancellation."
    },
    "minimum-stability" : "dev"
}
